{
  // quotle-info community backend (votes + nominations).
  // Deploy to a SEPARATE Cloudflare account from Mast — see README.md.
  "name": "quotle-community",
  "main": "src/index.js",
  "compatibility_date": "2026-05-05",
  "observability": { "enabled": true },

  // D1: create with `wrangler d1 create quotle-community`, then paste the printed
  // database_id below (it is NOT a secret — it's just an identifier).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quotle-community",
      "database_id": "85344c93-f0b6-4010-b603-f59ed1aacb20"
    }
  ]

  // Secrets are NOT declared here — set them once with:
  //   wrangler secret put TURNSTILE_SECRET
  //   wrangler secret put ADMIN_TOKEN
  //   wrangler secret put IP_SALT
}
